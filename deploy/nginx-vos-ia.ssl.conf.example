# Nginx — VOS IA con HTTPS propio (Let's Encrypt de vos-ia.com).
# No usar el certificado de arandanocafe.com.
#
# 1) Emitir cert (una vez):
#    sudo certbot certonly --nginx -d vos-ia.com -d www.vos-ia.com \
#      --non-interactive --agree-tos --register-unsafely-without-email --expand
# 2) Copiar este archivo y recargar:
#    sudo cp deploy/nginx-vos-ia.ssl.conf.example /etc/nginx/sites-available/vos-ia.com
#    sudo ln -sf /etc/nginx/sites-available/vos-ia.com /etc/nginx/sites-enabled/vos-ia.com
#    sudo nginx -t && sudo systemctl reload nginx

server {
  listen 80;
  listen [::]:80;
  server_name vos-ia.com www.vos-ia.com;
  return 301 https://vos-ia.com$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name vos-ia.com www.vos-ia.com;

  ssl_certificate     /etc/letsencrypt/live/vos-ia.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/vos-ia.com/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  client_max_body_size 20m;
  gzip on;
  gzip_types text/plain text/css application/javascript application/json application/manifest+json image/svg+xml;

  location /auth/google {
    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 30s;
  }

  location /backend/ {
    proxy_pass http://127.0.0.1:3001/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 120s;
  }

  location /ws {
    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
  }

  location /assets/ {
    proxy_pass http://127.0.0.1:5174;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options "nosniff";
  }

  location = /manifest.webmanifest {
    proxy_pass http://127.0.0.1:5174;
    default_type application/manifest+json;
    add_header Cache-Control "no-cache";
  }

  location / {
    proxy_pass http://127.0.0.1:5174;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header X-Forwarded-Proto https;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-cache";
  }
}

# Nginx — VOS IA en vos-ia.com con certificado PROPIO.
# Nunca usar el cert ni el vhost de arandanocafe.com.
# El puerto :3000 es Next.js de Arándano Café — no proxyar acá.
#
# Instalar con: bash scripts/fix-vos-ia-https.sh
# No correr `certbot --nginx` (pega vos-ia.com al site del café).

# HTTP: desafío ACME + canónico a HTTPS. Sin redirect a arandanocafe.com.
server {
  listen 80;
  listen [::]:80;
  server_name vos-ia.com www.vos-ia.com;

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
  }

  location / {
    return 301 https://vos-ia.com$request_uri;
  }
}

# Dominio viejo → VOS IA (solo HTTP; el cert de vos-ia.com no cubre este nombre).
server {
  listen 80;
  listen [::]:80;
  server_name vos-ai.arandano.shop;

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
  }

  location / {
    return 301 https://vos-ia.com$request_uri;
  }
}

# www → apex, mismo certificado (SAN incluye www).
server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name www.vos-ia.com;

  ssl_certificate     /etc/letsencrypt/live/vos-ia.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/vos-ia.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  ssl_session_tickets off;

  return 301 https://vos-ia.com$request_uri;
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name vos-ia.com;

  ssl_certificate     /etc/letsencrypt/live/vos-ia.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/vos-ia.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  ssl_session_tickets off;

  client_max_body_size 20m;
  gzip on;
  gzip_types text/plain text/css application/javascript application/json application/manifest+json image/svg+xml;

  location /auth/google {
    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 30s;
  }

  location /backend/ {
    proxy_pass http://127.0.0.1:3001/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 120s;
  }

  location /ws {
    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
  }

  location /assets/ {
    proxy_pass http://127.0.0.1:5174;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options "nosniff";
  }

  location = /manifest.webmanifest {
    proxy_pass http://127.0.0.1:5174;
    default_type application/manifest+json;
    add_header Cache-Control "no-cache";
  }

  location / {
    proxy_pass http://127.0.0.1:5174;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header X-Forwarded-Proto https;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-cache";
  }
}

# Nginx — VOS IA en HTTP (sin SSL). Sirve el front en :5174, nunca :3000.
# HTTPS: usá bash scripts/fix-vos-ia-https.sh (webroot). NO uses certbot --nginx.
#
#   sudo cp deploy/nginx-vos-ia.conf.example /etc/nginx/sites-available/vos-ia.com
#   sudo ln -sf /etc/nginx/sites-available/vos-ia.com /etc/nginx/sites-enabled/vos-ia.com
#   sudo nginx -t && sudo systemctl reload nginx

server {
  listen 80;
  listen [::]:80;
  server_name vos-ia.com www.vos-ia.com vos-ai.arandano.shop;

  client_max_body_size 20m;
  gzip on;
  gzip_types text/plain text/css application/javascript application/json application/manifest+json image/svg+xml;

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
  }

  # OAuth Google — el redirect URI de Google Cloud debe coincidir
  # (https://vos-ia.com/auth/google/callback). Ir ANTES de location /.
  location /auth/google {
    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }

  # API bajo /backend/
  location /backend/ {
    proxy_pass http://127.0.0.1:3001/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
  }

  location /ws {
    proxy_pass http://127.0.0.1:3001;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
  }

  # JS/CSS con hash: cache largo en Chrome Android.
  location /assets/ {
    proxy_pass http://127.0.0.1:5174;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options "nosniff";
  }

  location = /manifest.webmanifest {
    proxy_pass http://127.0.0.1:5174;
    default_type application/manifest+json;
    add_header Cache-Control "no-cache";
  }

  # Front Vite (PM2 :5174) — index.html sin cache para deploys limpios.
  location / {
    proxy_pass http://127.0.0.1:5174;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-cache";
  }
}
